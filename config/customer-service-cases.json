        },
        {
          "message": "再便宜一点",
          "expected": {"intent": "search", "tools": ["catalog_search"], "grounding_pass": true, "price_max_lt_previous": true}
        },
        {
          "message": "对比前两款",
          "expected": {"intent": "compare", "tools": ["product_detail"], "grounding_pass": true}
        }
      ]
    },
