# Core runtime. Without an LLM credential the project falls back to rules.
# Default: data/retailpilot.db; an existing data/ecommerce.db is reused automatically.
# Set this only to override automatic selection or to use a separate database.
# RETAILPILOT_DB_PATH=data/retailpilot.db
# RETAILPILOT_* takes priority over the supported legacy ECOMMERCE_* variables.
RETAILPILOT_VECTOR_DIM=384

# Unified text spaces. Hash is an explicit deterministic offline mode.
# Set a locally available Sentence Transformers model and build before production use.
RETAILPILOT_KNOWLEDGE_PRODUCT_MODEL=hash
RETAILPILOT_KNOWLEDGE_PRODUCT_REVISION=main
RETAILPILOT_KNOWLEDGE_POLICY_MODEL=disabled
RETAILPILOT_KNOWLEDGE_POLICY_REVISION=main
RETAILPILOT_KNOWLEDGE_QDRANT_URL=
RETAILPILOT_KNOWLEDGE_QDRANT_KEY=
RETAILPILOT_EMBEDDING_DEVICE=auto
RETAILPILOT_PLATFORM=demo-mall

POLICY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
POLICY_RERANKER_ENABLED=false
POLICY_FUSION_LIMIT=30
RETAILPILOT_CANDIDATE_POOL_LIMIT=0
RETAILPILOT_EVAL_SAMPLE_RATE=0.05

# Safe clone default. Change to llm only after configuring a working model endpoint.
INTENT_MODE=rules

# off: deterministic query pipeline only
# fallback: call an LLM only for low-confidence query understanding
# hybrid: call an LLM on every query-understanding pass
LLM_MODE=off
# Leave empty for deterministic offline mode. Never commit a real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Harness context capacity for the configured model (used only to calculate
# occupancy; compaction triggers at 80% and is not a fixed turn/token window).
LLM_CONTEXT_WINDOW=128000
LLM_THINKING=false
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# Per-scene output caps. These do not change history compaction or prompt caching.
LLM_MAX_TOKENS_INTENT_ROUTER=1200
LLM_MAX_TOKENS_AFTER_SALES_PLANNER=1200
LLM_MAX_TOKENS_QUERY_REFINE=600
LLM_MAX_TOKENS_POLICY_EVIDENCE=600
LLM_MAX_TOKENS_HISTORY_SUMMARY=1000
LLM_MAX_TOKENS_REPLY_SEARCH=800
LLM_MAX_TOKENS_REPLY_DETAIL=800
LLM_MAX_TOKENS_REPLY_COMPARE=800
LLM_MAX_TOKENS_REPLY_ORDER=800
LLM_MAX_TOKENS_REPLY_POLICY=800
LLM_MAX_TOKENS_CHITCHAT=256
# Optional gateway billing rates. Leave blank to record tokens/cache hits without
# producing a misleading cost estimate.
LLM_INPUT_COST_PER_1M=
LLM_CACHED_INPUT_COST_PER_1M=
LLM_CACHE_CREATION_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=

# Isolated LLM-as-Judge endpoint. The judge must never reuse LLM_* credentials;
# semantic evaluation refuses to run until JUDGE_API_KEY is set.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=20
JUDGE_MAX_RETRIES=1
# Includes hidden reasoning tokens on reasoning-compatible judge models.
JUDGE_MAX_TOKENS=3000
JUDGE_JSON_MODE=true

# Protected API access. Configure browser users below or send a service key as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`.
# With neither configured, protected endpoints fail closed with 401/503.
# Only set true for a local single-user demo without a reverse proxy.
RETAILPILOT_API_KEY=
RETAILPILOT_ALLOW_OPEN_API=false

# Protected browser mode: generate password hashes with scripts/create_web_user.py.
# Keep this server-side JSON out of source control. Use HTTPS with Secure cookies.
RETAILPILOT_AUTH_USERS_JSON={}
RETAILPILOT_AUTH_COOKIE_SECURE=true
RETAILPILOT_AUTH_SESSION_SECONDS=3600
# Service API keys always act as this identity; request bodies cannot impersonate users.
RETAILPILOT_API_USER_ID=service-user

# Optional multimodal retrieval and curated asset publication
RETAILPILOT_MM_ENABLED=0
RETAILPILOT_MM_VISUAL_ENABLED=0
RETAILPILOT_MM_STORE=data/assets
RETAILPILOT_MM_CURATORS=
RETAILPILOT_MM_REMOTE_HOSTS=
RETAILPILOT_MM_PARSER=docling
RETAILPILOT_MM_DOCLING_ARTIFACTS=
RETAILPILOT_MM_OCR=off
RETAILPILOT_MM_OCR_LANGUAGES=chi_sim+eng
RETAILPILOT_MM_VLM_URL=
RETAILPILOT_MM_VLM_KEY=
RETAILPILOT_MM_VLM_MODEL=
RETAILPILOT_MM_VISUAL_MODEL=google/siglip2-base-patch16-224
RETAILPILOT_MM_VISUAL_REVISION=main
RETAILPILOT_MM_VISUAL_MIN_SCORE=0.12
RETAILPILOT_MM_LOCAL_MODELS_ONLY=0
RETAILPILOT_MM_MAX_BYTES=16777216
RETAILPILOT_MM_MAX_PAGES=40
RETAILPILOT_MM_MAX_PIXELS=20000000
RETAILPILOT_MM_TILE_HEIGHT=1400
RETAILPILOT_MM_CONTEXT_TOKENS=96
RETAILPILOT_MM_TOP_K=32
RETAILPILOT_MM_EVIDENCE_PER_SKU=3
RETAILPILOT_MM_VERIFY_IMAGES=2
RETAILPILOT_MM_VERIFY_TOKENS=360
RETAILPILOT_MM_VERIFY_TIMEOUT=8
RETAILPILOT_MM_PROCESS_TIMEOUT=180
# Evidence-driven policy followup (read-only, after the initial retrieval).
POLICY_FOLLOWUP_ENABLED=true
POLICY_MAX_EXTRA_HOPS=2
POLICY_FOLLOWUP_TIMEOUT_SECONDS=45
POLICY_MAX_EVIDENCE_CHUNKS=12
POLICY_EVIDENCE_TOKEN_BUDGET=10000
POLICY_FOLLOWUP_LLM_TOKEN_BUDGET=80000
LLM_MAX_TOKENS_POLICY_EVIDENCE=1600
POLICY_FAITHFULNESS_TIMEOUT_SECONDS=30
POLICY_FAITHFULNESS_LLM_TOKEN_BUDGET=80000
LLM_MAX_TOKENS_FAITHFULNESS_CHECK=800
LLM_MAX_TOKENS_FAITHFULNESS_REPAIR=1800


# Unified generative gateway. Legacy is the reversible rollout default.
RETAILPILOT_EVIDENCE_MODE=legacy
RETAILPILOT_REASONING_ENABLED=true
# Explicit settings take priority over legacy LLM_* / MM_VLM_*.
# Leave these commented until selecting the deployment model.
# RETAILPILOT_REASONING_MODEL=
# RETAILPILOT_REASONING_BASE_URL=
# RETAILPILOT_REASONING_API_KEY=
RETAILPILOT_REASONING_SUPPORTS_VISION=false
RETAILPILOT_REASONING_SUPPORTS_STRUCTURED_OUTPUT=false
RETAILPILOT_REASONING_CAPABILITIES_FILE=
RETAILPILOT_EVIDENCE_MAX_EXTRA_HOPS=2
RETAILPILOT_EVIDENCE_MAX_IMAGES=2
RETAILPILOT_EVIDENCE_TIMEOUT=30
RETAILPILOT_EVIDENCE_TOKEN_BUDGET=80000
# Optional model override, e.g. RETAILPILOT_REASONING_MODEL_FAITHFULNESS_CHECK.
RETAILPILOT_EVIDENCE_MAX_RECORDS=12
RETAILPILOT_EVIDENCE_CONTEXT_BYTES=10000
# Optional independent verification of one observation; reserves an image slot.
RETAILPILOT_EVIDENCE_INDEPENDENT_VISION_CHECK=false
# Vendor-specific thinking body fields are opt-in for the unified model.
RETAILPILOT_REASONING_SEND_THINKING=false
