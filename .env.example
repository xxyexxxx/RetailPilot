# Core runtime. Without an LLM credential the project falls back to rules.
# Default: data/retailpilot.db; an existing data/ecommerce.db is reused automatically.
# Set this only to override automatic selection or to use a separate database.
# RETAILPILOT_DB_PATH=data/retailpilot.db
# RETAILPILOT_* takes priority over the supported legacy ECOMMERCE_* variables.
RETAILPILOT_VECTOR_DIM=384

# Neural retrieval. "auto" uses a locally built neural index and otherwise
# falls back to the deterministic hash route. Build with scripts/build_embeddings.py.
# Keep hash as the safe default. Set auto or BAAI/bge-small-zh-v1.5 only after shadow eval.
RETAILPILOT_EMBEDDING_MODEL=hash
RETAILPILOT_EMBEDDING_INDEX_DIR=data/embeddings
RETAILPILOT_EMBEDDING_DEVICE=auto
RETAILPILOT_EMBEDDING_MIN_SCORE=0.42
RETAILPILOT_PLATFORM=demo-mall

# Policy RAG: install requirements-policy-rag.txt, import the corpus, build the
# index, then enable Qdrant. No hash-vector semantic fallback is used.
POLICY_VECTOR_BACKEND=disabled
POLICY_QDRANT_URL=
POLICY_QDRANT_API_KEY=
POLICY_QDRANT_PATH=data/qdrant
# Keep the stored collection name for compatibility with existing policy indexes.
# A new index can use retailpilot_policy_chunks; rebuild it before switching names.
POLICY_QDRANT_COLLECTION=ecommerce_policy_chunks
POLICY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
POLICY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
POLICY_RERANKER_ENABLED=false
POLICY_BM25_LIMIT=40
POLICY_DENSE_LIMIT=40
POLICY_FUSION_LIMIT=30
POLICY_RRF_K=60
RETAILPILOT_CANDIDATE_POOL_LIMIT=0
RETAILPILOT_EVAL_SAMPLE_RATE=0.05

# Safe clone default. Change to llm only after configuring a working model endpoint.
INTENT_MODE=rules

# off: deterministic query pipeline only
# fallback: call an LLM only for low-confidence query understanding
# hybrid: call an LLM on every query-understanding pass
LLM_MODE=off
# Leave empty for deterministic offline mode. Never commit a real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Harness context capacity for the configured model (used only to calculate
# occupancy; compaction triggers at 80% and is not a fixed turn/token window).
LLM_CONTEXT_WINDOW=128000
LLM_THINKING=false
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
# Per-scene output caps. These do not change history compaction or prompt caching.
LLM_MAX_TOKENS_INTENT_ROUTER=1200
LLM_MAX_TOKENS_AFTER_SALES_PLANNER=1200
LLM_MAX_TOKENS_QUERY_REFINE=600
LLM_MAX_TOKENS_POLICY_EVIDENCE=600
LLM_MAX_TOKENS_HISTORY_SUMMARY=1000
LLM_MAX_TOKENS_REPLY_SEARCH=800
LLM_MAX_TOKENS_REPLY_DETAIL=800
LLM_MAX_TOKENS_REPLY_COMPARE=800
LLM_MAX_TOKENS_REPLY_ORDER=800
LLM_MAX_TOKENS_REPLY_POLICY=800
LLM_MAX_TOKENS_CHITCHAT=256
# Optional gateway billing rates. Leave blank to record tokens/cache hits without
# producing a misleading cost estimate.
LLM_INPUT_COST_PER_1M=
LLM_CACHED_INPUT_COST_PER_1M=
LLM_CACHE_CREATION_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=

# Isolated LLM-as-Judge endpoint. The judge must never reuse LLM_* credentials;
# semantic evaluation refuses to run until JUDGE_API_KEY is set.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=20
JUDGE_MAX_RETRIES=1
# Includes hidden reasoning tokens on reasoning-compatible judge models.
JUDGE_MAX_TOKENS=3000
JUDGE_JSON_MODE=true

# Public API access. Keep empty for the safe default: every /api endpoint
# returns 401/503 until the key is configured and sent as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`.
# Only set true for a local single-user demo without a reverse proxy.
RETAILPILOT_API_KEY=
RETAILPILOT_ALLOW_OPEN_API=false
# Evidence-driven policy followup (read-only, after the initial retrieval).
POLICY_FOLLOWUP_ENABLED=true
POLICY_MAX_EXTRA_HOPS=2
POLICY_FOLLOWUP_TIMEOUT_SECONDS=45
POLICY_MAX_EVIDENCE_CHUNKS=12
POLICY_EVIDENCE_TOKEN_BUDGET=10000
POLICY_FOLLOWUP_LLM_TOKEN_BUDGET=80000
LLM_MAX_TOKENS_POLICY_EVIDENCE=1600
POLICY_FAITHFULNESS_TIMEOUT_SECONDS=30
POLICY_FAITHFULNESS_LLM_TOKEN_BUDGET=80000
LLM_MAX_TOKENS_FAITHFULNESS_CHECK=800
LLM_MAX_TOKENS_FAITHFULNESS_REPAIR=1800

